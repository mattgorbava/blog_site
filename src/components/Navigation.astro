---
import '../styles/global.css';

const currentPath = Astro.url.pathname;

const isActive = (path: string) =>
	path === '/' ? currentPath === path : currentPath.startsWith(path);
---
<div id="main-menu" class="navigation">
	<ul>
    <li><a href="/" class:list={{ active: isActive('/') }} aria-current={isActive('/') ? 'page' : undefined}>Home</a></li>
    <li><a href="/about/" class:list={{ active: isActive('/about/') }} aria-current={isActive('/about/') ? 'page' : undefined}>About</a></li>
    <li><a href="/blog/" class:list={{ active: isActive('/blog/') }} aria-current={isActive('/blog/') ? 'page' : undefined}>Blog</a></li>
    </ul>
</div>