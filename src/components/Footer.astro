---
const platform = "github";
const username = "mattgorbava";

import InstagramLogo from '../assets/Instagram-Logo.wine.svg';
import LinkedInLogo from '../assets/LinkedIn-Icon-Logo.wine.svg';
import '../styles/global.css';
import SocialMedia from './SocialMedia.astro';
---

<footer class="footer">
  <ul>
    <li><p>Learn more about my work! Find me on Instagram and LinkedIn!</p></li>
    <li>
      <SocialMedia platform = "instagram" username = "stefi.ioneasca" icon = {InstagramLogo.src}/>
    </li>
    <li>
      <SocialMedia platform = "linkedin" username = "in/stefania-ioneasca" icon = {LinkedInLogo.src}/>
    </li>
  </ul>
</footer>